# Cloudflare Pages — Security & Cache Headers
# Updated: 2026-04-04

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-XSS-Protection: 1; mode=block
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' www.googletagmanager.com; style-src 'self' 'unsafe-inline' fonts.googleapis.com; img-src 'self' data: *.googleapis.com *.gstatic.com *.google.com tile.openstreetmap.org *.tile.openstreetmap.org; font-src 'self' fonts.gstatic.com; connect-src 'self' www.googletagmanager.com *.google-analytics.com *.analytics.google.com *.googletagmanager.com; frame-src https://www.google.com https://maps.google.com; object-src 'none'; base-uri 'self'; form-action 'self'

# Static assets — aggressive caching
/images/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=2592000, s-maxage=31536000

/js/*
  Cache-Control: public, max-age=2592000, s-maxage=31536000

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Favicons
/images/favicon.png
  Cache-Control: public, max-age=31536000, immutable

# 管理画面 — オーナー専用・低トラフィックなので常に最新を配信（版ズレ防止）
/admin/*
  Cache-Control: no-cache, must-revalidate

# HTML pages — cache but revalidate
/*.html
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=3600

/
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=3600

/rent/
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=3600

/posts/*
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=3600

# Baked language pages (fr/de/zh/he) — same policy as their EN originals
/fr/*
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=3600

/de/*
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=3600

/zh/*
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=3600

/he/*
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=3600

/category/
  Cache-Control: public, max-age=1800, s-maxage=43200, stale-while-revalidate=1800

# Overnight DB (michi-no-eki) — HTML same as other pages, open-data JSON moderate cache
/overnight-parking/*
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=3600

/overnight-parking/michi-no-eki/data.json
  Cache-Control: public, max-age=3600, s-maxage=86400
  Content-Type: application/json; charset=utf-8

# API — no cache
/api/*
  Cache-Control: no-store, no-cache, must-revalidate

# Sitemap & robots — moderate cache
/sitemap.xml
  Cache-Control: public, max-age=3600, s-maxage=86400
  Content-Type: application/xml

/robots.txt
  Cache-Control: public, max-age=86400

/llms.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8

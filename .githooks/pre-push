#!/usr/bin/env bash
# ============================================================
# VTJ pre-push ガードレール
# - force push（非fast-forward）とリモートブランチ削除をブロック
# - push範囲に対して scripts/security-audit.sh を強制実行
# 初回セットアップ: git config core.hooksPath .githooks
# （--no-verify での回避は原則禁止 — CLAUDE.md 参照）
# ============================================================
set -uo pipefail
REPO_ROOT=$(git rev-parse --show-toplevel)
ZERO="0000000000000000000000000000000000000000"
FAIL=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_ref:-}" ] && continue

  if [ "$local_sha" = "$ZERO" ]; then
    echo "🚫 リモートブランチの削除はブロックしました: $remote_ref"
    echo "   本当に必要なら手動で確認の上 --no-verify を使ってください。"
    FAIL=1
    continue
  fi

  if [ "$remote_sha" != "$ZERO" ]; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      echo "🚫 force push（非fast-forward）は禁止です: $remote_ref"
      echo "   リモートの履歴を失う操作です。pull/rebase してから通常pushしてください。"
      FAIL=1
      continue
    fi
    RANGE="$remote_sha..$local_sha"
  else
    # 新規ブランチ: origin/main を基準に監査（無ければ直近50コミット）
    if git rev-parse --verify -q origin/main >/dev/null; then
      RANGE="origin/main..$local_sha"
    else
      RANGE="$local_sha~50..$local_sha"
    fi
  fi

  echo "🔎 push前監査: $RANGE"
  if ! bash "$REPO_ROOT/scripts/security-audit.sh" --range-sha "$RANGE"; then
    FAIL=1
  fi
done

if [ "$FAIL" -ne 0 ]; then
  echo ""
  echo "🚫 pre-push ガードレールにより push を中止しました。"
  exit 1
fi
exit 0
